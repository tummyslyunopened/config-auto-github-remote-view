DJANGO_SECRET_KEY=change-me-in-deployment
DEBUG=False

# Where config-auto-github writes its observable state. Defaults assume the
# standard layout where it writes inside the submodule checkout, e.g.
# ~/config/config-auto-github/. Override any path that lives elsewhere.
# CAG_DATA_DIR=C:/Users/<you>/config/config-auto-github
# CAG_QUEUE_FILE=             # single JSON file (preferred); takes precedence over CAG_QUEUE_DIR
# CAG_QUEUE_DIR=              # fallback: directory of per-item *.json files
# CAG_MONITOR_LOG=            # default <CAG_DATA_DIR>/logs/monitor.log
# CAG_WORKER_LOG=             # default <CAG_DATA_DIR>/logs/worker.log
# CAG_MONITOR_PIDFILE=        # default <CAG_DATA_DIR>/monitor.pid
# CAG_WORKER_PIDFILE=         # default <CAG_DATA_DIR>/worker.pid
# CAG_LOG_TAIL_LINES=200
# CAG_REFRESH_SECONDS=5
